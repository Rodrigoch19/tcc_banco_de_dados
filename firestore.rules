rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsProfile(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validProfile(data) {
      return data.keys().hasOnly([
          'email',
          'password',
          'displayName',
          'about',
          'points',
          'selectedTitleId',
          'alertsPublished',
          'groupsJoined',
          'groupsCreated',
          'messagesSent',
          'createdAt',
          'updatedAt'
        ])
        && data.email is string
        // Campo temporario para testes; continua opcional para perfis existentes.
        && (!('password' in data) || data.password is string)
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && data.about is string
        && data.about.size() > 0
        && data.about.size() <= 500
        && data.selectedTitleId is string
        && data.points is int
        && data.points >= 0
        && data.alertsPublished is int
        && data.alertsPublished >= 0
        && data.groupsJoined is int
        && data.groupsJoined >= 0
        && data.groupsCreated is int
        && data.groupsCreated >= 0
        && data.messagesSent is int
        && data.messagesSent >= 0;
    }

    match /profiles/{userId} {
      allow read: if ownsProfile(userId);
      allow create: if ownsProfile(userId)
        && validProfile(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow update: if ownsProfile(userId)
        && validProfile(request.resource.data)
        && request.resource.data.email == resource.data.email
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
